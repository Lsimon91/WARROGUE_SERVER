PORT=80
WSS_PORT=443
MAX_ROOMS=500
ROOM_IDLE_MINUTES=30
HEARTBEAT_INTERVAL_MS=25000
RATE_LIMIT_PER_SEC=60
BOT_WAIT_MS=10000
# easy | normal | hard | expert
BOT_DIFFICULTY=normal
AUTO_BOT_ARENA=true
PEACE_SECONDS=120
TRUST_PROXY=false
# Optional direct TLS. Leave unset behind a TLS reverse proxy.
 TLS_KEY_FILE=/absolute/path/to/server.key
 TLS_CERT_FILE=/absolute/path/to/server.crt
 DATA_FILE=/absolute/path/to/warrogue.json
